@article{Craig2021,
    author={Craig, David W.
    and Hutchins, Elizabeth
    and Violich, Ivo
    and Alsop, Eric
    and Gibbs, J. Raphael
    and Levy, Shawn
    and Robison, Madison
    and Prasad, Nripesh
    and Foroud, Tatiana
    and Crawford, Karen L.
    and Toga, Arthur W.
    and Whitsett, Timothy G.
    and Kim, Seungchan
    and Casey, Bradford
    and Reimer, Alyssa
    and Hutten, Samantha J.
    and Frasier, Mark
    and Kern, Fabian
    and Fehlman, Tobias
    and Keller, Andreas
    and Cookson, Mark R.
    and Van Keuren-Jensen, Kendall
    and Hutten, Samantha
    and Initiative, Parkinson Progression Marker},
    title={RNA sequencing of whole blood reveals early alterations in immune cells and gene expression in Parkinson's disease},
    journal={Nature Aging},
    year={2021},
    month={08},
    day={01},
    volume={1},
    number={8},
    pages={734-747},
    abstract={Changes in the blood-based RNA transcriptome have the potential to inform biomarkers of Parkinson's disease (PD) progression. Here we sequenced a discovery set of whole-blood RNA species in 4,871 longitudinally collected samples from 1,570 clinically phenotyped individuals from the Parkinson's Progression Marker Initiative (PPMI) cohort. Samples were sequenced to an average of 100 million read pairs to create a high-quality transcriptome. Participants with PD in the PPMI had significantly altered RNA expression (>2,000 differentially expressed genes), including an early and persistent increase in neutrophil gene expression, with a concomitant decrease in lymphocyte cell counts. This was validated in a cohort from the Parkinson's Disease Biomarkers Program (PDBP) consisting of 1,599 participants and by alterations in immune cell subtypes. This publicly available transcriptomic dataset, coupled with available detailed clinical data, provides new insights into PD biological processes impacting whole blood and new paths for developing diagnostic and prognostic PD biomarkers.},
    issn={2662-8465},
    doi={10.1038/s43587-021-00088-6},
    url={https://doi.org/10.1038/s43587-021-00088-6}
}

﻿@article{Kern2021,
author={Kern, Fabian
and Fehlmann, Tobias
and Violich, Ivo
and Alsop, Eric
and Hutchins, Elizabeth
and Kahraman, Mustafa
and Grammes, Nadja L.
and Guimar{\~a}es, Pedro
and Backes, Christina
and Poston, Kathleen L.
and Casey, Bradford
and Balling, Rudi
and Geffers, Lars
and Kr{\"u}ger, Rejko
and Galasko, Douglas
and Mollenhauer, Brit
and Meese, Eckart
and Wyss-Coray, Tony
and Craig, David W.
and Van Keuren-Jensen, Kendall
and Keller, Andreas},
title={Deep sequencing of sncRNAs reveals hallmarks and regulatory modules of the transcriptome during Parkinson's disease progression},
journal={Nature Aging},
year={2021},
month={03},
day={01},
volume={1},
number={3},
pages={309-322},
abstract={Noncoding RNAs have diagnostic and prognostic importance in Parkinson's disease (PD). We studied circulating small noncoding RNAs (sncRNAs) in two large-scale longitudinal PD cohorts (Parkinson's Progression Markers Initiative (PPMI) and Luxembourg Parkinson's Study (NCER-PD)) and modeled their impact on the transcriptome. Sequencing of sncRNAs in 5,450 blood samples of 1,614 individuals in PPMI yielded 323 billion reads, most of which mapped to microRNAs but covered also other RNA classes such as piwi-interacting RNAs, ribosomal RNAs and small nucleolar RNAs. Dysregulated microRNAs associated with disease and disease progression occur in two distinct waves in the third and seventh decade of life. Originating predominantly from immune cells, they resemble a systemic inflammation response and mitochondrial dysfunction, two hallmarks of PD. Profiling 1,553 samples from 1,024 individuals in the NCER-PD cohort validated biomarkers and main findings by an independent technology. Finally, network analysis of sncRNA and transcriptome sequencing from PPMI identified regulatory modules emerging in patients with progressing PD.},
issn={2662-8465},
doi={10.1038/s43587-021-00042-6},
url={https://doi.org/10.1038/s43587-021-00042-6}
}

